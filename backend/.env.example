# MySQL
DB_URL=jdbc:mysql://localhost:3306/algovisual?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=algovisual_app
DB_PASSWORD=replace-with-a-local-database-password

# JWT: generate a unique Base64 secret, for example: openssl rand -base64 64
JWT_SECRET=replace-with-a-random-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# Frontend origin used by CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
